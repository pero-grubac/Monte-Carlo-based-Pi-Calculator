<Window x:Class="MonteCarloPi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonteCarloPi.Desktop"
        xmlns:controls="clr-namespace:MonteCarloPi.Desktop.Controls"
        xmlns:vm="clr-namespace:MonteCarloPi.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Monte Carlo π"
        Width="1280" Height="860" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">

  <Window.Resources>
    <local:VisibleWhenConverter x:Key="VisibleWhen" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PauseCommand}" />
    <KeyBinding Key="R" Modifiers="Control" Command="{Binding ResetCommand}" />
  </Window.InputBindings>

  <Grid Margin="28,18,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ResetCommand}" ToolTip="Clear the points and start over (Ctrl+R)"
                AutomationProperties.AutomationId="ResetButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
            <TextBlock Text="Reset" />
          </StackPanel>
        </Button>
        <Button Command="{Binding PauseCommand}" Margin="12,0,0,0" Padding="16,6" ToolTip="Pause (Ctrl+P)"
                AutomationProperties.AutomationId="PauseButton"
                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="0,0,8,0" />
            <TextBlock Text="Pause" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding StartCommand}" Margin="12,0,0,0" Padding="16,6"
                ToolTip="Start throwing points (Ctrl+Enter)" AutomationProperties.AutomationId="StartButton"
                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
            <TextBlock Text="{Binding StartLabel}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Monte Carlo π" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}" Text="Estimate π by throwing random points at a square and counting those that land in the circle" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="500" />
      </Grid.ColumnDefinitions>

      <!-- The square -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
              <Run Text="π ≈ 4 ×" /> <Run Text="inside" FontStyle="Italic" /> <Run Text="/" /> <Run Text="all points" FontStyle="Italic" />
            </TextBlock>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Caption}" Text="inside the circle" Margin="6,0,18,0" VerticalAlignment="Center" />
              <Ellipse Width="10" Height="10" Fill="{StaticResource OutsideBrush}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Caption}" Text="outside" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>

          <controls:PointCloudView x:Name="PointCloud"
                                   InsideBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                   OutsideBrush="{StaticResource OutsideBrush}"
                                   OutlineBrush="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="170" />
        </Grid.RowDefinitions>

        <!-- Estimate -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Estimate" />
            <TextBlock FontFamily="{StaticResource DigitsFont}" FontSize="40" FontWeight="SemiBold" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="EstimateText">
              <Run Text="{Binding CorrectDigits, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><Run Text="{Binding OtherDigits, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </TextBlock>
            <TextBlock FontFamily="{StaticResource DigitsFont}" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,0,14">
              <Run Text="{Binding PiDigits, Mode=OneWay}" /> <Run Text=" π" FontFamily="Segoe UI" />
            </TextBlock>

            <UniformGrid Columns="3">
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Points" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CountText}" AutomationProperties.AutomationId="CountText" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Inside the circle" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding InsideText}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Correct decimals" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding MatchingText}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Error" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ErrorText}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="95% interval" ToolTip="The true π lies within this distance of the estimate in 95% of runs" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding IntervalText}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}">
                  <Run Text="Speed ·" /> <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding SpeedText}" Margin="0,2,0,0" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Run settings -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <StackPanel IsEnabled="{Binding CanEditSettings}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Number of points" IsChecked="{Binding IsPointsMode}" Margin="0,0,20,0" GroupName="Mode"
                             AutomationProperties.AutomationId="PointsMode" />
                <RadioButton Content="Until decimals match" IsChecked="{Binding IsDecimalsMode}" GroupName="Mode"
                             AutomationProperties.AutomationId="DecimalsMode" />
              </StackPanel>

              <!-- Fixed number of points -->
              <StackPanel Visibility="{Binding IsPointsMode, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                  <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding PointPresets}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PointPreset}">
                        <Button Content="{Binding Label}" Padding="10,5" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="{Binding Label, StringFormat=Preset{0}}"
                                Command="{Binding DataContext.SetPointsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Text="{Binding PointsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PointsBox"
                           ToolTip="For example 1000000, 1e6 or 2.5M" />
                </DockPanel>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PointsError}"
                           Visibility="{Binding PointsError, Converter={StaticResource VisibleWhen}}" />
              </StackPanel>

              <!-- Until the decimals match -->
              <StackPanel Visibility="{Binding IsDecimalsMode, Converter={StaticResource VisibleWhen}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Decimals" Margin="0,0,12,0" />
                  <Button Style="{StaticResource StepperButton}" Content="&#xE738;" Command="{Binding FewerDecimalsCommand}" AutomationProperties.Name="Fewer decimals" />
                  <TextBlock Text="{Binding Decimals}" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                  <Button Style="{StaticResource StepperButton}" Content="&#xE710;" Command="{Binding MoreDecimalsCommand}" AutomationProperties.Name="More decimals"
                          AutomationProperties.AutomationId="MoreDecimals" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding DecimalsWindowText}" Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding ExpectedPointsText}" Margin="0,2,0,0" />
              </StackPanel>

              <DockPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Seed" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="blank = random" />
                <TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" ToolTip="The same seed repeats a run exactly"
                         AutomationProperties.AutomationId="SeedBox" />
              </DockPanel>
              <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SeedError}"
                         Visibility="{Binding SeedError, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,16,0,6" />
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Visibility="{Binding UsedSeed, Converter={StaticResource VisibleWhen}}">
                <Run Text="seed" /> <Run Text="{Binding UsedSeed, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" AutomationProperties.AutomationId="StatusText" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Convergence -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="shaded: where 95% of runs are" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource CardTitle}" Text="Convergence" />
            </DockPanel>
            <controls:ConvergenceChart History="{Binding History}"
                                       MaxPoints="{Binding ChartMaxPoints}"
                                       LineBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                       BandBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
